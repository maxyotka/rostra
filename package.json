{
  "name": "rostra-ui",
  "version": "0.2.0",
  "description": "A component system for admin panels and internal corporate tools: four themes, four densities, a dependency-free CSS core, an optional React layer, verified WCAG 2.1 AA contrast, and a separate build supporting IE10+",
  "license": "MIT",
  "author": "maxyotka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxyotka/rostra.git"
  },
  "homepage": "https://maxyotka.github.io/rostra/examples/",
  "bugs": {
    "url": "https://github.com/maxyotka/rostra/issues"
  },
  "keywords": [
    "design-system",
    "ui",
    "react",
    "css",
    "admin",
    "tokens",
    "a11y"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./rostra.css": "./rostra.css",
    "./rostra.legacy.css": "./rostra.legacy.css",
    "./fonts.css": "./fonts.css",
    "./tokens.json": "./rostra.tokens.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "rostra.css",
    "rostra.legacy.css",
    "fonts.css",
    "rostra.tokens.json",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "build:legacy": "node scripts/build-legacy.mjs",
    "build:js": "node scripts/build-js.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run build:css && npm run build:legacy && npm run build:js && npm run build:types && npm run build:api && npm run build:playground",
    "check:tokens": "node scripts/build-css.mjs --check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:support": "node scripts/check-support.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:tokens && npm run check:contrast && npm run typecheck && npm test",
    "build:api": "node scripts/build-api-docs.mjs",
    "build:playground": "node scripts/build-playground.mjs",
    "check:api": "node scripts/build-api-docs.mjs --check"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.5.4",
    "axe-core": "^4.10.2",
    "caniuse-lite": "^1.0.30001809",
    "culori": "^4.0.1",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
