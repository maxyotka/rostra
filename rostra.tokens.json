    "fs-section": "15.5px",
    "fs-body": "13.5px",
    "fs-ui": "12.5px",
    "fs-label": "11.5px",
    "lh-body": "1.6",
    "lh-ui": "1.4",
    "radius-xs": "2px",
    "radius-sm": "4px",
    "radius": "6px",
    "radius-lg": "10px",
    "radius-pill": "999px",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-7": "32px",
    "space-8": "40px",
    "dur-instant": "120ms",
